<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Header: City & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="📍 هەولێر"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:text="✨ کاتەکانی بانگ"
            android:textColor="#F1F5F9"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Next Prayer Highlight Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_card_bg"
        android:orientation="vertical"
        android:padding="9dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_next_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="--:--"
                android:textColor="#38BDF8"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_next_prayer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="نوێژی داهاتوو"
                android:textColor="#FBBF24"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_bg"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="⏱️ ماوە بۆ بانگ"
                android:textColor="#FDE68A"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- All 5 Prayer Times Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:weightSum="5">

        <!-- Fajr -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="1.5dp"
            android:layout_weight="1">

            <!-- Inactive State -->
            <LinearLayout
                android:id="@+id/widget_fajr_inactive_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_inactive_prayer_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="5dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/widget_fajr_inactive_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="🌅 بەیانی"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_fajr_inactive_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="--:--"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Active State -->
            <LinearLayout
                android:id="@+id/widget_fajr_active_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_active_prayer_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="5dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_fajr_active_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="🌅 بەیانی"
                    android:textColor="#FBBF24"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_fajr_active_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="--:--"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Dhuhr -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="1.5dp"
            android:layout_weight="1">

            <!-- Inactive State -->
            <LinearLayout
                android:id="@+id/widget_dhuhr_inactive_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_inactive_prayer_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="5dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/widget_dhuhr_inactive_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="🌤️ نیوەڕۆ"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_dhuhr_inactive_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="--:--"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Active State -->
            <LinearLayout
                android:id="@+id/widget_dhuhr_active_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_active_prayer_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="5dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_dhuhr_active_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="🌤️ نیوەڕۆ"
                    android:textColor="#FBBF24"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_dhuhr_active_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="--:--"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Asr -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="1.5dp"
            android:layout_weight="1">

            <!-- Inactive State -->
            <LinearLayout
                android:id="@+id/widget_asr_inactive_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_inactive_prayer_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="5dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/widget_asr_inactive_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="🌥️ عەسر"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_asr_inactive_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="--:--"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Active State -->
            <LinearLayout
                android:id="@+id/widget_asr_active_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_active_prayer_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="5dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_asr_active_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="🌥️ عەسر"
                    android:textColor="#FBBF24"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_asr_active_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="--:--"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Maghrib -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="1.5dp"
            android:layout_weight="1">

            <!-- Inactive State -->
            <LinearLayout
                android:id="@+id/widget_maghrib_inactive_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_inactive_prayer_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="5dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/widget_maghrib_inactive_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="🌆 مەغریب"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_maghrib_inactive_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="--:--"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Active State -->
            <LinearLayout
                android:id="@+id/widget_maghrib_active_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_active_prayer_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="5dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_maghrib_active_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="🌆 مەغریب"
                    android:textColor="#FBBF24"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_maghrib_active_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="--:--"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Isha -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="1.5dp"
            android:layout_weight="1">

            <!-- Inactive State -->
            <LinearLayout
                android:id="@+id/widget_isha_inactive_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_inactive_prayer_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="5dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/widget_isha_inactive_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="🌙 عیشا"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_isha_inactive_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="--:--"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Active State -->
            <LinearLayout
                android:id="@+id/widget_isha_active_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_active_prayer_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="5dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_isha_active_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="🌙 عیشا"
                    android:textColor="#FBBF24"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_isha_active_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="--:--"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
